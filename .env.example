PROJECT_NAME=PayGuard AI
DATABASE_URL=sqlite:///./payguard.db

# Supabase Authentication Configuration
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks

# Legacy authentication (for development/migration only)
PAYGUARD_SECRET_KEY=v2_secret_key_dev_only

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional comma-separated Checkout method hints. Leave blank to let Razorpay account config decide.
RAZORPAY_CHECKOUT_METHODS=

GEMINI_API_KEY=
AI_PROVIDER=mock

EMAIL_PROVIDER=mock
EMAIL_FROM=receipts@payguard.local
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=PAYGRD

WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
